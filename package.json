{
  "name": "the-guide",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "npm start",
    "build": "npm run build:elixirs",
    "build:elixirs": "node scripts/elixirs/build.mjs",
    "audit:elixirs": "node scripts/elixirs/audit.mjs dist/elixirs-pages",
    "start": "npm run build && npm run audit:elixirs && npm run start:elixirs",
    "start:elixirs": "node scripts/elixirs/serve.mjs --root dist/elixirs-pages --port 4173",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:elixirs": "npm run test:e2e",
    "validate": "npm run lint && npm run typecheck && npm run test && npm run build && npm run audit:elixirs && npm run test:e2e"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^24.0.0",
    "@playwright/test": "1.61.1",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "4.1.10"
  }
}
