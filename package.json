{
  "name": "the-guide",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:elixirs": "node scripts/elixirs/build.mjs",
    "audit:elixirs": "node scripts/elixirs/audit.mjs dist/elixirs-pages",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:elixirs": "playwright test --config playwright.elixirs.config.ts",
    "validate": "npm run lint && npm run typecheck && npm run test && npm run build && npm run build:elixirs && npm run test:e2e && npm run test:e2e:elixirs"
  },
  "dependencies": {
    "next": "16.2.10",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@playwright/test": "1.61.1",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.2.10",
    "typescript": "^5.9.3",
    "vitest": "4.1.10"
  },
  "overrides": {
    "postcss": "8.5.10"
  }
}
